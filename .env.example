# ---- Choose ONE provider block ------------------------------------------

# A) Anthropic API (simplest for a first test; web search supported)
ANTHROPIC_API_KEY=sk-ant-...

# B) Claude on Microsoft Foundry
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=<your-foundry-resource-name>
# ANTHROPIC_FOUNDRY_API_KEY=<key>          # or leave unset to use Entra ID / managed identity

# C) Through your AI gateway (APIM or LiteLLM)
# ANTHROPIC_BASE_URL=https://<gateway-host>/<path>
# ANTHROPIC_AUTH_TOKEN=<gateway credential>
# ANTHROPIC_CUSTOM_HEADERS=Ocp-Apim-Subscription-Key: <key>

# ---- App settings ---------------------------------------------------------
# Model ID (Anthropic API) or deployment name (Foundry). Leave empty for the SDK default.
AGENT_MODEL=
AGENT_MAX_TURNS=6
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_CONCURRENT=3
APP_TIME_ZONE=Asia/Kolkata
AGENT_WORK_ROOT=/tmp/agent-runs

# Switch the SDK to Bedrock
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1                 # required; it isn't read from ~/.aws/config
AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-

# Credentials: pick one option
# AWS_ACCESS_KEY_ID=...                # option 1: IAM user keys

# AWS_SESSION_TOKEN=...              # only if you use temporary credentials
# AWS_BEARER_TOKEN_BEDROCK=...       # option 2: Bedrock API key instead of IAM keys
# AWS_PROFILE=my-profile             # option 3: local machine only

# Model: use the Bedrock model / inference profile ID, not the Anthropic name
#AGENT_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0